# General
# ------------------------------------------------------------------------------
USE_DOCKER=yes
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY
IPYTHONDIR=/app/.ipython

# Database
# ------------------------------------------------------------------------------
# Docker internal hostname, not localhost: `.env` holds the host-mode value
# (host Django + infra containers, see AGENTS.md), and every container that
# reads it from there — django, celeryworker, celerybeat, mcp, sqlmesh-ui —
# would then dial the container's own loopback and fail. Overrides `.env`
# because this file is loaded after it (see the env_file list in
# docker-compose.yml).
DATABASE_URL=postgres://rADfmsnMjDXKephNGWFkfdPkuSAjdASF:glm5bKLmVKkfdJaM9qkDREdor4y8uSEJZKZvLVwP5jeEX6YSnw6DnNG9EYvupSlg@postgres:5432/brewgis

# Redis
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# Celery
# ------------------------------------------------------------------------------

# Off (real async via the celeryworker container) so long-running tasks —
# e.g. a large paint operation — actually background instead of blocking
# the request inline, which is what DEBUG's implicit default would do.
CELERY_TASK_ALWAYS_EAGER=False

# Flower
CELERY_FLOWER_USER=komkgDMMBitfqRabgrYDlEKCynFCWYOQ
CELERY_FLOWER_PASSWORD=DTWvUkZNIUACsu1J0yygxl7T9TjDfWUQbJSZGmjieqhBvp0bbSIu7g34oa62POHT
LGBM_INFERENCE_BATCH_SIZE=10000

# Tile server (Docker internal hostname, not localhost)
# ------------------------------------------------------------------------------
TILE_SERVER_TIPG_URL=http://tipg:8081
TILE_SERVER_MARTIN_URL=http://martin:3000

GDAL_DISABLE_READDIR_ON_OPEN=EMPTY_DIR
