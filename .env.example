# Django
DJANGO_READ_DOT_ENV_FILE=True
DJANGO_DEBUG=True
DJANGO_TESTING=false
DJANGO_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
USE_DOCKER=no

# Database (localhost, not Docker service name)
DATABASE_URL=postgres://rADfmsnMjDXKephNGWFkfdPkuSAjdASF:glm5bKLmVKkfdJaM9qkDREdor4y8uSEJZKZvLVwP5jeEX6YSnw6DnNG9EYvupSlg@localhost:5432/brewgis

# Redis (localhost, not Docker service name)
REDIS_URL=redis://localhost:6379/0

# Census API (required for demographics and employment data)
# Get a free key at https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
# dlt (data load tool) — reuses DATABASE_URL for Postgres destination
# Tile server backend (tipg or martin) — this is now a per-workspace
# setting (see Workspace.tile_server_backend); these vars only set the
# fallback default and the URLs the app talks to.
TILE_SERVER_BACKEND=tipg
TILE_SERVER_TIPG_URL=http://localhost:8081
TILE_SERVER_MARTIN_URL=http://localhost:3000

# GID of the host's `docker` group (owner of /var/run/docker.sock), so the
# django container — which runs as a non-root user — can use the
# socket mount to restart Martin after new tables appear. Find yours with:
#   stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# Celery
CELERY_TASK_EAGER_PROPAGATES=True
# An analysis run's own time limits, in seconds. A cold plan loads the whole
# SQLMesh project before it plans anything and then materializes the upstream
# models the scenario has never built (ResNet features, the assessor ArcGIS
# fetch, NLCD parcel stats), so it needs far longer than the 60s soft / 5m
# hard global limits. Raise these where a cold plan is longer still.
ANALYSIS_TASK_SOFT_TIME_LIMIT=1800
ANALYSIS_TASK_TIME_LIMIT=3600
