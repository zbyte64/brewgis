#!/bin/bash
set -o errexit
set -o pipefail
set -o nounset

# sqlmesh writes its log directory relative to the working directory, and in the
# production image /app is root-owned, so run from the user's home instead.
cd "${HOME}"
exec sqlmesh -p /app/brewgis/sqlmesh/ ui --host 0.0.0.0 --port 8001 --mode "${SQLMESH_UI_MODE:-ide}"
